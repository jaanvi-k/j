@FunctionalInterface
interface MyFI1 {
    void show();
}
@FunctionalInterface
interface MyFI2 {
    void display(int a);
}
@FunctionalInterface
interface MyFI3 {
    void disp(int b, int c);
}
public class LambdaExpression {
    public static void main (String args[]) {
        MyFI1 obj1 = () -> System.out.println("No Parameter");
        obj1.show();
        MyFI2 obj2 = (a) -> System.out.println("One Parameter:" + a);
        obj2.display(5);
        MyFI3 obj3 = (b, c) -> System.out.println("Two Parameters sum: " + (b+c));
        obj3.disp(7, 3);
    }
}
