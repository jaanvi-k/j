class A extends Thread {
    public void run() {
        for (int i=10; i<=20; i++) {
            System.out.println(i);
            if (i == 11)
                try {
                    Thread.sleep(500);
                }
                catch (Exception e) {}
        }
    }
}
class B extends Thread {
    public void run() {
        for (int i=20; i>=10; i--)
            System.out.println(i);
    }
}

// Execution statements:
A a = new A();
B b = new B();
a.start();
b.start();
